diff --git a/interface/user_command/udp_command_interface.hpp b/interface/user_command/udp_command_interface.hpp
new file mode 100644
index 0000000..fd0a14c
--- /dev/null
+++ b/interface/user_command/udp_command_interface.hpp
@@ -0,0 +1,134 @@
+#pragma once
+
+#include "user_command_interface.h"
+#include "custom_types.h"
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <cstring>
+#include <mutex>
+#include <thread>
+
+#include <arpa/inet.h>
+#include <netinet/in.h>
+#include <sys/socket.h>
+#include <sys/time.h>
+#include <unistd.h>
+
+using namespace interface;
+using namespace types;
+
+// Localhost command protocol:
+// LITE3_CMD_V1 <sequence> <target_mode> <vx_scale> <vy_scale> <wz_scale>
+// Velocity fields are normalized to [-1, 1]. Missing packets zero velocity.
+class UdpCommandInterface : public UserCommandInterface {
+public:
+    explicit UdpCommandInterface(int port = 30011, int timeout_ms = 300)
+        : port_(port), timeout_ms_(timeout_ms) {
+        std::memset(&usr_cmd_, 0, sizeof(usr_cmd_));
+        last_packet_ = std::chrono::steady_clock::now();
+        std::cout << "Using localhost UDP Command Interface on 127.0.0.1:"
+                  << port_ << std::endl;
+    }
+
+    ~UdpCommandInterface() { Stop(); }
+
+    void Start() override {
+        running_ = true;
+        thread_ = std::thread(&UdpCommandInterface::Run, this);
+    }
+
+    void Stop() override {
+        running_ = false;
+        if (socket_fd_ >= 0) {
+            shutdown(socket_fd_, SHUT_RDWR);
+        }
+        if (thread_.joinable()) thread_.join();
+        if (socket_fd_ >= 0) close(socket_fd_);
+        socket_fd_ = -1;
+    }
+
+    UserCommand GetUserCommand() override {
+        std::lock_guard<std::mutex> lock(mutex_);
+        UserCommand result = usr_cmd_;
+        const auto age = std::chrono::duration_cast<std::chrono::milliseconds>(
+            std::chrono::steady_clock::now() - last_packet_).count();
+        if (age > timeout_ms_) {
+            result.forward_vel_scale = 0.0f;
+            result.side_vel_scale = 0.0f;
+            result.turnning_vel_scale = 0.0f;
+        }
+        return result;
+    }
+
+    void SetMotionStateFeedback(const MotionStateFeedback& feedback) override {
+        std::lock_guard<std::mutex> lock(mutex_);
+        msfb_ = feedback;
+    }
+
+private:
+    void Run() {
+        socket_fd_ = socket(AF_INET, SOCK_DGRAM, 0);
+        if (socket_fd_ < 0) {
+            std::cerr << "Failed to create command socket" << std::endl;
+            return;
+        }
+
+        timeval receive_timeout{0, 100000};
+        setsockopt(socket_fd_, SOL_SOCKET, SO_RCVTIMEO,
+                   &receive_timeout, sizeof(receive_timeout));
+
+        sockaddr_in address{};
+        address.sin_family = AF_INET;
+        address.sin_port = htons(port_);
+        address.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+        if (bind(socket_fd_, reinterpret_cast<sockaddr*>(&address),
+                 sizeof(address)) < 0) {
+            std::cerr << "Failed to bind command socket" << std::endl;
+            return;
+        }
+
+        while (running_) {
+            char buffer[256]{};
+            const auto length = recvfrom(socket_fd_, buffer, sizeof(buffer) - 1,
+                                         0, nullptr, nullptr);
+            if (length <= 0) continue;
+
+            unsigned long long sequence = 0;
+            int target_mode = 0;
+            float vx = 0.0f, vy = 0.0f, wz = 0.0f;
+            if (std::sscanf(buffer, "LITE3_CMD_V1 %llu %d %f %f %f",
+                            &sequence, &target_mode, &vx, &vy, &wz) != 5) {
+                continue;
+            }
+            if (target_mode != RobotMotionState::WaitingForStand &&
+                target_mode != RobotMotionState::StandingUp &&
+                target_mode != RobotMotionState::JointDamping &&
+                target_mode != RobotMotionState::LieDown &&
+                target_mode != RobotMotionState::RLControlMode) {
+                continue;
+            }
+
+            std::lock_guard<std::mutex> lock(mutex_);
+            if (sequence <= last_sequence_) continue;
+            last_sequence_ = sequence;
+            usr_cmd_.target_mode = target_mode;
+            usr_cmd_.forward_vel_scale = std::clamp(vx, -1.0f, 1.0f);
+            usr_cmd_.side_vel_scale = std::clamp(vy, -1.0f, 1.0f);
+            usr_cmd_.turnning_vel_scale = std::clamp(wz, -1.0f, 1.0f);
+            last_packet_ = std::chrono::steady_clock::now();
+        }
+    }
+
+    const int port_;
+    const int timeout_ms_;
+    int socket_fd_{-1};
+    std::atomic<bool> running_{false};
+    std::thread thread_;
+    std::mutex mutex_;
+    UserCommand usr_cmd_{};
+    unsigned long long last_sequence_{0};
+    std::chrono::steady_clock::time_point last_packet_;
+};
