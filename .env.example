# Pilot and Scene use the same OpenAI-compatible vision/language model.
VLM_BASE_URL=
VLM_API_KEY=
VLM_MODEL=

# Tencent Cloud account credentials used by the configured ASR/TTS backend.
# Engine, voice, region, sample rate, and codec remain in robonix_manifest.yaml.
TENCENT_ASR_APPID=
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=

# ROS 2 middleware used by every native package in this deployment. Keep both
# values equal. Fast DDS uses DDS discovery and needs no Zenoh router.
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
ROBONIX_RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# Optional deployment paths and web-viewer port. By default, the Robonix
# checkout is discovered as the `robonix` directory beside this repository.
# ROBONIX_SOURCE_DIR=/absolute/path/to/robonix
LITE3_VIEWER_PORT=8080
LITE3_ENVIRONMENT=scenesmith_house_187
# Optional alternate collision-free pose for cold-start localization tests.
# LITE3_SPAWN_X=3.92
# LITE3_SPAWN_Y=1.00
# LITE3_SPAWN_YAW=1.57
